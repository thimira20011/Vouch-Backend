{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // REQUIRED: Set via environment variable ConnectionStrings__DefaultConnection
    // or appsettings.Local.json (gitignored).
    "DefaultConnection": ""
  },
  "Jwt": {
    // REQUIRED: Minimum 32 characters. Set via environment variable Jwt__Key.
    "Key": "",
    "Issuer": "VouchBackend",
    "Audience": "VouchFrontend"
  },
  "Security": {
    // REQUIRED: AES-256 key for PII encryption. Set via environment variable Security__EncryptionKey.
    "EncryptionKey": "",
    // REQUIRED: Independent >=32-character HMAC email lookup key; keep stable across encryption rotations.
    "EmailLookupKey": ""
  },
  "Anthropic": {
    // OPTIONAL: Set via environment variable Anthropic__ApiKey.
    "ApiKey": ""
  },
  "Cors": {
    // Step 13: Configurable allowed origins. Override per environment via env var Cors__AllowedOrigins__0, etc.
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Smtp": {
    // Step 18 (NFR-12): SMTP settings for high-severity report alerts.
    // Development can leave Host empty; alert emails remain pending. Production requires SMTP.
    // Set via environment variables: Smtp__Host, Smtp__Port, Smtp__User, Smtp__Password, etc.
    "Host": "",
    "Port": "587",
    "User": "",
    "Password": "",
    "FromAddress": ""
  },
  "PhotoStorage": {
    // Step 13: encrypted PostgreSQL storage. This is the authorized API route, never a CDN.
    // Legacy BasePath settings are ignored; filesystem photos are not served.
    "BaseUrl": "/photos"
  }
}
