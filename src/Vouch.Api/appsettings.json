{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // REQUIRED: Set via environment variable ConnectionStrings__DefaultConnection
    // or appsettings.Local.json (gitignored).
    "DefaultConnection": ""
  },
  "Jwt": {
