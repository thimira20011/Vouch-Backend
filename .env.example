# ============================================================
# Vouch Backend — Required Environment Variables
# ============================================================
# Copy this file to .env for Docker Compose and fill in blank required secrets.
# This is key=value syntax, NOT JSON. Do not copy it to appsettings.Local.json.
# dotnet run does not load .env; export variables or use valid local JSON instead.
#
# In production (Docker / Railway / Azure App Service), use
# the double-underscore convention for nested keys:
#   Jwt__Key=your-secret-here
#   ConnectionStrings__DefaultConnection=your-connection-string
# ============================================================


# ── Database ─────────────────────────────────────────────────
# Compose uses these to configure PostgreSQL and the API's container connection.
POSTGRES_DB=vouch_db
POSTGRES_USER=vouch
POSTGRES_PASSWORD=
# dotnet run uses this separate host connection string (Compose overrides it).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=vouch_db;Username=vouch;Password=CHANGE_ME


# ── JWT Authentication ────────────────────────────────────────
# REQUIRED — minimum 32 characters (HMAC-SHA256).
# Generate a strong value with: openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=VouchBackend
Jwt__Audience=VouchFrontend


# ── PII Encryption (AES-256) ──────────────────────────────────
# REQUIRED — used to encrypt sensitive user fields at rest.
# Generate a strong value with: openssl rand -base64 32
Security__EncryptionKey=


# ── Anthropic (AI Wingman) ────────────────────────────────────
# OPTIONAL — leave empty to use curated fallback icebreakers without LLM calls.
Anthropic__ApiKey=

# CORS: replace with the actual browser origins for your environment.
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:3000

# SMTP: optional in development. Configure all fields before enabling alerts.
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__FromAddress=
Smtp__ArchitectEmail=

# Local photo disk path; empty selects wwwroot/photos. Compose uses its photo volume.
PhotoStorage__BasePath=
PhotoStorage__BaseUrl=/photos

# Seed reference data for local development; this does NOT create an admin.
# Set false for production; migration/admin provisioning work is tracked in Step 5.
ASPNETCORE_ENVIRONMENT=Development
Database__SeedOnStartup=true
BackgroundJobs__Enabled=true

# Local JSON only loads in Development. Environment/CLI settings take precedence.
# Logging__File__Enabled=false disables the local file log.
# ReverseProxy__KnownProxies__0=IP_OF_YOUR_ACTUAL_PROXY
# Never enable ASPNETCORE_FORWARDEDHEADERS_ENABLED to trust arbitrary proxies.
# Integration tests use a separate explicit variable, not DefaultConnection:
# VOUCH_TEST_POSTGRES_ADMIN=Host=127.0.0.1;Port=55432;Database=vouch_test_admin;Username=vouch_test_runner;Password=YOUR_TEST_PASSWORD
